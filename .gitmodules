# NOTE:
# These URLs are kept as the external model-repo manifest for this project.
# The active AutoDL layout keeps heavy/dirty model repositories under
# `/root/autodl-tmp/models/` and links them into `model/`.
# Use `scripts/bootstrap_model_repos.sh` on a new host.
#
# They are not currently active gitlink submodules in the main repo index:
# `git ls-files --stage | grep '^160000'` should be checked before relying on
# `git submodule update --init`.
#
[submodule "model/DeepECG"]
	path = model/DeepECG
	url = https://github.com/HeartWise-AI/DeepECG_Docker.git
[submodule "model/ECGTwin"]
	path = model/ECGTwin
	url = https://github.com/Raiiyf/ECGTwin.git
[submodule "model/ecg_ptbxl_benchmarking"]
	path = model/ecg_ptbxl_benchmarking
	url = https://github.com/helme/ecg_ptbxl_benchmarking.git
[submodule "model/advdiff"]
	path = model/advdiff
	url = https://github.com/EricDai0/advdiff.git
