{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ECG_adv_Gen experiment config",
  "type": "object",
  "required": ["experiment", "runner", "paper_protocol", "data", "preprocess", "model", "evaluation", "logging"],
  "properties": {
    "experiment": {
      "type": "object",
      "required": ["name", "version", "status"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "integer"},
        "description": {"type": "string"},
        "owner": {"type": "string"},
        "status": {"type": "string"}
      },
      "additionalProperties": true
    },
    "runner": {
      "type": "object",
      "required": ["entrypoint"],
      "oneOf": [
        {"required": ["argv"]},
        {"required": ["adapter"]}
      ],
      "properties": {
        "entrypoint": {"type": "string"},
        "adapter": {
          "type": "string",
          "enum": [
            "benchmark_vae_lhat",
            "direct_finetune",
            "ecgfounder_vae_lhat",
            "effnet_vae_lhat",
            "pn2021_eval",
            "pn2021c_eval",
            "prompt_token_online_at"
          ]
        },
        "argv": {"type": "array"},
        "env": {"type": "object"},
        "matrix": {"type": "object"}
      },
      "additionalProperties": true
    },
    "paper_protocol": {
      "type": "object",
      "required": ["mapping_version", "mapping_hash", "class_order", "num_classes", "kshot", "selection"],
      "additionalProperties": true
    },
    "data": {
      "type": "object",
      "required": ["source_dataset", "target_dataset", "pn2021_cache_version", "exclude_centers"],
      "additionalProperties": true
    },
    "preprocess": {
      "type": "object",
      "required": ["contract_id", "classifier_fs", "classifier_len", "lead_order"],
      "properties": {
        "contract_id": {"type": "string"},
        "classifier_fs": {"type": "integer"},
        "classifier_len": {"type": "integer"},
        "crop_len": {"type": "integer"},
        "mode": {"type": "string"},
        "norm_mode": {"type": "string"},
        "lead_order": {"type": "string"},
        "ecgtwin_decode": {"type": "object"},
        "ecgfounder": {
          "type": "object",
          "properties": {
            "preprocess_policy": {"type": "string"},
            "input_fs": {"type": "integer"},
            "input_len": {"type": "integer"},
            "input_shape": {
              "type": "array",
              "items": {"type": "integer"}
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "model": {
      "type": "object",
      "required": ["backbone", "num_classes"],
      "additionalProperties": true
    },
    "evaluation": {
      "type": "object",
      "required": ["views", "metrics"],
      "properties": {
        "eval_protocol": {
          "type": "object",
          "properties": {
            "name": {"type": "string"},
            "min_target_ref_excluded": {"type": "integer"},
            "allow_missing_centers": {"type": "boolean"}
          },
          "additionalProperties": true
        },
        "pn2021c": {
          "type": "object",
          "properties": {
            "required_cache_version": {"type": "string"},
            "severity_profile": {"type": "string"},
            "corruption_seed": {"type": "integer"}
          },
          "additionalProperties": true
        },
        "prompt_token_online_at": {
          "type": "object",
          "properties": {
            "quick_eval_source": {"type": "string"},
            "classes_in_scope": {
              "type": "array",
              "items": {"type": "string"}
            }
          },
          "additionalProperties": true
        },
        "direct_finetune": {
          "type": "object",
          "properties": {
            "val_fraction": {"type": "number"},
            "subset_root": {"type": "string"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "logging": {
      "type": "object",
      "required": ["launch_artifacts", "child_artifacts", "postprocess_artifacts"],
      "properties": {
        "launch_artifacts": {
          "type": "array",
          "items": {"type": "string"}
        },
        "child_artifacts": {
          "type": "array",
          "items": {"type": "string"}
        },
        "postprocess_artifacts": {
          "type": "array",
          "items": {"type": "string"}
        },
        "required_epoch_metrics": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": true
    },
    "run_record": {
      "type": "object",
      "properties": {
        "purpose": {"type": "string"},
        "result_summary": {"type": "string"},
        "outcome": {"type": "string"},
        "status": {"type": "string"},
        "registration_status": {
          "type": "string",
          "enum": ["trusted", "provisional", "deprecated", "failed", "exploratory"]
        }
      },
      "additionalProperties": true
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string"},
          "requires": {
            "type": "array",
            "items": {"type": "string"}
          },
          "produces": {
            "type": "array",
            "items": {"type": "string"}
          },
          "skip_if_exists": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": true
      }
    },
    "postprocess": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "entrypoint", "argv", "expected_artifacts"],
            "properties": {
              "name": {"type": "string"},
              "entrypoint": {"type": "string"},
              "argv": {"type": "array"},
              "env": {"type": "object"},
              "expected_artifacts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["role", "path"],
                  "properties": {
                    "role": {"type": "string"},
                    "path": {"type": "string"},
                    "required": {"type": "boolean"}
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
