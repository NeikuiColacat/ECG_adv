# Prevent accidental large artifact commits. Existing tracked thesis figures,
# small JSON/CSV evidence, and the curated Figure 3.3 sample stay tracked.
artifacts/**/*.pt
artifacts/**/*.pth
artifacts/**/*.onnx
artifacts/**/*.engine
artifacts/**/*.npy
artifacts/**/*.npz
!artifacts/samples/generated_ecg_examples/thesis_selected_samples.npz

# Training-scale local outputs should live under ECG_ADV_DATA_ROOT or an
# external artifact bundle, not in the repository.
*.pt
*.pth
*.ckpt
*.onnx
*.engine
*.npy
*.npz
*.pkl
*.joblib
*.h5
*.tar
*.tar.gz
*.zip

# Personal thesis docs (contain student ID / personal info)
docs/*.docx
docs/~$*.docx

# Personal autodl GPU keep-alive script (not project code)
util/test_wave.py

# External model repos live on the data disk and are linked from model/.
# Track only model/.gitignore and model/README.md; recreate links with
# scripts/bootstrap_model_repos.sh.
model/*
!model/.gitignore
!model/README.md

# Legacy/local external repos are not part of the current mainline bootstrap.
model/SA-AET/
model/augmix/

